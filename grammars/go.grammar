// Go (1.26, and generic methods), parsed by tree-sitter (the fork grammars/tree-sitter-go of tree-sitter-go 0.25.0) and mapped by the mapping of crates/lang-go/lang.yaml.
// A node kind is a row named like tree-sitter's node in Pascal case; the keywords and operators are grouped into a few tokens.
// Format: see crates/core-syntax/src/grammar/mod.rs.

language go 28 "Go"
comments line "//" block "/*" "*/"
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
// `// text` and `/* text */`.
token Comment #trivia #comment

// A name: a variable, a function, a parameter.
token Ident
// The name of a field or method after a `.` or in a declaration.
token FieldIdent
// The name of a type.
token TypeIdent
// The name of a package: in `package p`, `p.T` and an import alias.
token PackageIdent
// The name of a label: `break L`, `L:`.
token LabelName
// `_`.
token BlankIdent
// The `.` of `import . "p"`.
token DotImport
// Reserved words (`func`, `type`, `range`, ...).
token Keyword
// `fallthrough`, wrapped in a statement node of its own.
token Fallthrough
// A lone `;`, wrapped in a statement node of its own.
token EmptySemi
// The operators of expressions and of a constraint (`~`).
token Op #operator
// `=` and the compound assignments `+=`, `<<=`, ...
token Assign #operator
// `:=`
token Define #operator
// `, ; : . ...`
token Punct #punctuation
// `( [ {` and their closers.
token Open #punctuation
token Close #punctuation
token Int #literal
token Float #literal
token Imaginary #literal
token Rune #literal
// An interpreted string and a raw string, quotes included.
token String #literal #string
token Nil #literal
token True #literal
token False #literal
token Iota #literal

token Eof
token Unknown #error

node SourceFile #scope
node PackageClause #namespace = Keyword name:PackageIdent
node ImportDeclaration
node ImportSpec
node ImportSpecList
node FunctionDeclaration #scope #function = Keyword name:Ident TypeParameterList? parameters:ParameterList result:ResultList? result_type:#type? result_token:TypeIdent? body:Block?
node MethodDeclaration #scope #function = Keyword receiver:ReceiverList name:FieldIdent TypeParameterList? parameters:ParameterList result:ResultList? result_type:#type? result_token:TypeIdent? body:Block?
node TypeParameterList
node TypeParameterDeclaration
node ParameterList #parameter-list
node ResultList #parameter-list
node ReceiverList #parameter-list
node ParameterDeclaration #parameter
node VariadicParameterDeclaration #parameter
node ConstDeclaration
node ConstSpec #const-spec = name:Ident
node VarDeclaration
node VarSpec #var-spec = name:Ident
node VarSpecList
node TypeDeclaration
node TypeSpec #scope #type-spec = name:TypeIdent
node TypeAlias #scope #type-spec = name:TypeIdent
node TypeArguments
node TypeElem
node TypeConstraint
node ArrayType #type
node ImplicitLengthArrayType #type
node SliceType #type
node StructType #type
node FieldDeclarationList
node FieldDeclaration #field-declaration
node PointerType #type
node FunctionType #scope #signature #type
node InterfaceType #type
node MethodElem #scope #signature = name:FieldIdent parameters:ParameterList result:ResultList? result_type:#type? result_token:TypeIdent?
node MapType #type
node ChannelType #type
node QualifiedType #type
node GenericType #type
node NegatedType #type
node ParenthesizedType #type
node Block #block
node StatementList
node EmptyStatement
node ExpressionStatement
node LabeledStatement
node EmptyLabeledStatement
node FallthroughStatement
node BreakStatement
node ContinueStatement
node GotoStatement
node ReturnStatement
node GoStatement
node DeferStatement
node IfStatement #scope
node ExpressionSwitchStatement #scope
node TypeSwitchStatement #scope
node ExpressionCase #scope
node TypeCase #scope
node DefaultCase #scope
node SelectStatement #scope
node CommunicationCase #scope
node ForStatement #scope
node ForClause
node RangeClause
node SendStatement
node ReceiveStatement
node IncStatement
node DecStatement
node AssignmentStatement
node ShortVarDeclaration #local-declaration = left:ExpressionList Define right:ExpressionList
node ExpressionList
node ParenthesizedExpression
node CallExpression
node ArgumentList
node VariadicArgument
node SelectorExpression
node IndexExpression
node SliceExpression
node TypeAssertionExpression
node TypeConversionExpression
node TypeInstantiationExpression
node BinaryExpression
node UnaryExpression
node CompositeLiteral
node LiteralValue
node LiteralElement
node KeyedElement
node FuncLiteral #scope #function = Keyword parameters:ParameterList result:ResultList? result_type:#type? result_token:TypeIdent? body:Block?
