// Go (1.26, and generic methods), parsed by tree-sitter (the fork grammars/tree-sitter-go of tree-sitter-go 0.25.0) and mapped by the mapping of crates/lang-go/lang.yaml.
// A node kind is a row named like tree-sitter's node in Pascal case; the keywords and operators are grouped into a few tokens.
// Format: see crates/core-syntax/src/grammar/mod.rs.

language go 28 "Go"
roles
comments line "//" block "/*" "*/"
suppress disable-next-line "sudsy-disable-next-line"
suppress disable-line "sudsy-disable-line"
suppress disable "sudsy-disable"
suppress enable "sudsy-enable"
suppress disable-file "sudsy-disable-file"
suppress ignore "sudsy-ignore"

token Whitespace #trivia #whitespace
token Newline #trivia #newline
// `// text` and `/* text */`.
token Comment #trivia #comment

// A name: a variable, a function, a parameter.
token Ident #expression
// The name of a field or method after a `.` or in a declaration.
token FieldIdent
// The name of a type.
token TypeIdent
// The name of a package: in `package p`, `p.T` and an import alias.
token PackageIdent #import-alias
// The name of a label: `break L`, `L:`.
token LabelName
// `_`.
token BlankIdent #import-alias
// The `.` of `import . "p"`.
token DotImport #import-alias
// Reserved words (`func`, `type`, `range`, ...).
token Keyword
// `fallthrough`, wrapped in a statement node of its own.
token Fallthrough
// A lone `;`, wrapped in a statement node of its own.
token EmptySemi
// The operators of expressions and of a constraint (`~`).
token Op #operator
// `=` and the compound assignments `+=`, `<<=`, ...
token Assign #operator
// `:=`
token Define #operator
// `, ; : . ...`
token Punct #punctuation #list-item
// `( [ {` and their closers.
token Open #punctuation
token Close #punctuation
token Int #expression #literal
token Float #expression #literal
token Imaginary #expression #literal
token Rune #expression #literal
// An interpreted string and a raw string, quotes included.
token String #expression #literal #string
token Nil #expression #literal
token True #expression #literal
token False #expression #literal
token Iota #expression #literal

token Eof
token Unknown #error

node SourceFile #scope #source-file
node PackageClause #namespace #opaque = Keyword name:PackageIdent
node ImportDeclaration #opaque
node ImportSpec #import = alias:#import-alias? path:String
node ImportSpecList #opaque
node FunctionDeclaration #scope #function = Keyword name:Ident TypeParameterList? parameters:ParameterList result:ResultList? result_type:#type? result_token:TypeIdent? body:Block?
node MethodDeclaration #scope #function = Keyword receiver:ReceiverList name:FieldIdent TypeParameterList? parameters:ParameterList result:ResultList? result_type:#type? result_token:TypeIdent? body:Block?
node TypeParameterList #opaque
node TypeParameterDeclaration #opaque
node ParameterList #parameter-list = Open parameters:#list-item* Close
node ResultList #parameter-list = Open parameters:#list-item* Close
node ReceiverList #parameter-list = Open parameters:#list-item* Close
node ParameterDeclaration #parameter #list-item #opaque
node VariadicParameterDeclaration #parameter #list-item #opaque
node ConstDeclaration #statement #opaque
node ConstSpec #const-spec #opaque = name:Ident
node VarDeclaration #statement #opaque
node VarSpec #var-spec #opaque = name:Ident
node VarSpecList #opaque
node TypeDeclaration #statement #opaque
node TypeSpec #scope #type-spec = name:TypeIdent TypeParameterList? Assign? #type? TypeIdent?
node TypeAlias #scope #type-spec = name:TypeIdent TypeParameterList? Assign? #type? TypeIdent?
node TypeArguments #opaque
node TypeElem #opaque
node TypeConstraint #opaque
node ArrayType #type #opaque
node ImplicitLengthArrayType #type #opaque
node SliceType #type #opaque
node StructType #type #opaque
node FieldDeclarationList #opaque
node FieldDeclaration #field-declaration #opaque
node PointerType #type #opaque
node FunctionType #scope #signature #type
node InterfaceType #type #opaque
node MethodElem #scope #signature = name:FieldIdent parameters:ParameterList result:ResultList? result_type:#type? result_token:TypeIdent?
node MapType #type #opaque
node ChannelType #type #opaque
node QualifiedType #type #opaque
node GenericType #type #opaque
node NegatedType #type #opaque
node ParenthesizedType #type #opaque
node Block #statement #block = Open items:StatementList? Close
node StatementList #statements = items:#statement*
node EmptyStatement #statement #opaque
node ExpressionStatement #statement #simple #opaque
node LabeledStatement #statement #goto-target #opaque
node EmptyLabeledStatement #statement #goto-target #opaque
node FallthroughStatement #statement #opaque
node BreakStatement #statement #break = Keyword label:LabelName?
node ContinueStatement #statement #continue = Keyword label:LabelName?
node GotoStatement #statement #goto #opaque
node ReturnStatement #statement #return = Keyword value:ExpressionList?
node GoStatement #statement #opaque
node DeferStatement #statement #opaque
node IfStatement #scope #statement #conditional = Keyword init:#simple? Punct? condition:#expression then:Block Keyword? else:#statement?
node ExpressionSwitchStatement #statement #scope
node TypeSwitchStatement #statement #scope
node ExpressionCase #scope
node TypeCase #scope
node DefaultCase #scope
node SelectStatement #statement #scope
node CommunicationCase #scope
node ForStatement #statement #scope #loop = Keyword condition:#for-head? cond_expr=condition:#expression? body:Block
node ForClause #for-head #opaque
node RangeClause #for-head #opaque
node SendStatement #statement #simple #opaque
node ReceiveStatement #opaque
node IncStatement #statement #simple #increment = #expression Op
node DecStatement #statement #simple #increment = #expression Op
node AssignmentStatement #statement #simple #assignment = left:ExpressionList operator:#operator right:ExpressionList
node ShortVarDeclaration #statement #simple #local-declaration #opaque = left:ExpressionList Define right:ExpressionList
node ExpressionList #opaque
node ParenthesizedExpression #expression #opaque
node CallExpression #expression #call = callee:#expression TypeArguments? arguments:ArgumentList
node ArgumentList #opaque
node VariadicArgument #opaque
node SelectorExpression #expression #opaque
node IndexExpression #expression #opaque
node SliceExpression #expression #opaque
node TypeAssertionExpression #expression #opaque
node TypeConversionExpression #expression #opaque
node TypeInstantiationExpression #expression #opaque
node BinaryExpression #expression #opaque
node UnaryExpression #expression #opaque
node CompositeLiteral #expression #opaque
node LiteralValue #opaque
node LiteralElement #opaque
node KeyedElement #opaque
node FuncLiteral #expression #scope #function = Keyword parameters:ParameterList result:ResultList? result_type:#type? result_token:TypeIdent? body:Block?
