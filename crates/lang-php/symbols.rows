// What PHP says to the symbol index: which node kinds declare types, functions, constants and
// imports, and the name rules (namespaces with imports, case-insensitive types, functions and
// methods, functions and constants that fall back to the global namespace). Format:
// core_semantics::symbols::rows.
separator \
absolute \
relative namespace
fold type function member
fallback function constant
constructor __construct
sigil $
dynamic-members __call __callstatic __get __set
declaring-calls define class_alias
promotion public protected private readonly
use-kinds function=function const=constant

Namespace namespace name=Identifier
Class type class name=Identifier modifiers=Keyword
Interface type interface name=Identifier modifiers=Keyword
Trait type trait name=Identifier modifiers=Keyword
Enum type enum name=Identifier modifiers=Keyword
Function function name=Identifier,Keyword,Boolean,Null name-after=function params=FunctionLikeParameterList
Method method name=Identifier,Keyword,Boolean,Null name-after=function params=FunctionLikeParameterList modifiers=Keyword
FunctionLikeParameter param name=DirectVariable optional=FunctionLikeParameterDefaultValue variadic=Ellipsis modifiers=Keyword
Constant global-const item=ConstantItem name=Identifier
ClassLikeConstant const item=ClassLikeConstantItem name=Identifier,Keyword,Boolean,Null modifiers=Keyword
PlainProperty property item=PropertyConcreteItem,PropertyAbstractItem name=DirectVariable modifiers=Keyword
EnumCase case item=EnumCaseBackedItem,EnumCaseUnitItem name=Identifier,Keyword,Boolean,Null
Extends heritage relation=extends names=Identifier
Implements heritage relation=implements names=Identifier
TraitUse mixin names=Identifier adapt=TraitUseConcreteSpecification
AttributeList ignore
EnumBackingTypeHint ignore
Use use
MixedUseItemList use-group names=Identifier
TypedUseItemSequence use-kind
MaybeTypedUseItem use-kind
UseItem use-item names=Identifier alias=UseItemAlias
